rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /listings/{listingId} {
      // Anonymous-auth mobile tracker can read all listings.
      allow get, list: if request.auth != null;

      // ...and can only update the `status` and `notes` fields on an
      // existing listing — never create, delete, or change anything else.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'notes']);

      // Only the Admin SDK (server-side, bypasses rules entirely) can
      // create or delete listings.
      allow create, delete: if false;
    }
  }
}
